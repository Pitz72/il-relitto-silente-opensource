# Python
__pycache__/
*.py[cod]

# Salvataggi del motore («salva» scrive <nome>.salvataggio nella cartella di lavoro)
*.salvataggio

# Esportazioni HTML giocabili (si rigenerano con «favella.py esporta»)
relitto-silente/*.html

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# App (Tauri + Vite): dipendenze, build, copie generate
app/node_modules/
app/dist/
app/public/pyodide/
app/src-tauri/target/
app/src-tauri/gen/

# Suoni: le sorgenti grezze restano fuori da git (registro in audio/LICENZE.md)
audio/sorgenti/

# Musica di Lyria 3.5: gli MP3 entrano in git (leggeri, l'autore li ha scelti); i formati pesanti no
audio/lyria/**/*.wav
audio/lyria/**/*.m4a
audio/lyria/**/*.flac
# File che non vengono da Lyria (es. Suno): restano in locale finche' l'autore non decide
audio/lyria/**/non-lyria/

# Le consegne all'autore: installer e versioni portatili (si rifanno con tauri build)
consegne/

# Le tracce sonore delle partite di collaudo (si rifanno con strumenti/audio/traccia.py --tutti)
collaudo/tracce/
