{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Il Relitto Silente",
  "mainBinaryName": "il-relitto-silente",
  "version": "../package.json",
  "identifier": "it.runtimeradio.relittosilente",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5274",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Il Relitto Silente",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#060708"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Game",
    "shortDescription": "Avventura testuale",
    "publisher": "Simone Pizzi",
    "copyright": "© 2026 Simone Pizzi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "risorse/audio/prova-ventilazione.ogg": "risorse/audio/prova-ventilazione.ogg",
      "risorse/audio/prototipo/": "risorse/audio/prototipo/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
