{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    // false per i loghi copiati pari pari dal Viaggiatore (src/loghi/suono.ts usa le
    // proprietà nei parametri del costruttore). I moduli che le prove leggono in Node
    // (prove/*.test.ts, con i tipi tolti da Node) non devono usarle: Node fallirebbe.
    "erasableSyntaxOnly": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
